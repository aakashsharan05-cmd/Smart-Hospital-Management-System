# Server Configuration
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Authentication (minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Database Connection
MONGOURL=mongodb+srv://<username>:<password>@cluster.mongodb.net/SHMS?retryWrites=true&w=majority

# Initial Admin Seed Credentials (scripts/createAdmin.js)
ADMIN_NAME="Hospital Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassword123!
ADMIN_PHONE=9876543210

# ML Wait-Time Prediction Service (Optional - falls back to formula 5 + queueLength * 8)
ML_SERVICE_URL=http://localhost:8000
DEFAULT_CONSULT_MIN=8

# AI Symptom Triage Service (Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
